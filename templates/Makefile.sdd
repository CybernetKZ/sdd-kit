# SDD checks (included from the main Makefile via: -include Makefile.sdd)
# Installed by sdd-kit/install.sh.

.PHONY: sdd-check sdd-doctor sdd-review sdd-flags sdd-test sdd-index

# Feature-flag expiry gate (ADR-0007): every registered flag has a death date.
# No feature_flags.py in the repo -> nothing to check, passes.
sdd-flags:
	@FILES=$$(git ls-files '*feature_flags.py' 2>/dev/null); \
	if [ -z "$$FILES" ]; then echo "sdd-flags: no flag registry — OK"; else \
	for f in $$FILES; do python3 "$$f" --check || exit 1; done; fi

# AI review of your current branch vs dev, on YOUR machine with YOUR
# subscription login (no shared tokens; CI AI-step stays optional).
# The prompt itself lives in .claude/scripts/review-prompt.md — one canonical
# text shared with .github/workflows/autoreview.yml.
# default review base = the repo's actual default branch (origin/HEAD), fallback dev (B3, ADR-0019)
SDD_REVIEW_BASE ?= $(shell git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' | grep . || echo dev)
sdd-review:
	@command -v claude >/dev/null || { echo "FAIL: claude CLI not found"; echo "next: install Claude Code and log in"; exit 1; }
	@test -f .claude/scripts/review-prompt.md || { echo "FAIL: .claude/scripts/review-prompt.md is missing"; echo "next: run sdd-kit/install.sh --repo-only on this repo"; exit 1; }
	@git diff "$(SDD_REVIEW_BASE)"...HEAD > /tmp/sdd-review.diff
	@test -s /tmp/sdd-review.diff || { echo "sdd-review: 0 changes vs $(SDD_REVIEW_BASE) — nothing to review"; exit 0; }
	@claude -p "$$(cat .claude/scripts/review-prompt.md)" --allowedTools "Read,Grep,Glob"

sdd-doctor:
	@bash .claude/scripts/sdd-doctor.sh

# openspec-pin: the npx call below pins the openspec version. This pin is
# independent of install.sh's on purpose — this file runs standalone inside the
# target repo (pre-commit, CI), with no sdd-kit checkout around. Bump both.
sdd-check:
	@test -f AGENTS.md || { echo "FAIL: AGENTS.md is missing"; echo "next: run sdd-kit/install.sh --repo-only on this repo"; exit 1; }
	@[ "$$(wc -l < AGENTS.md)" -le 500 ] || { echo "FAIL: AGENTS.md is longer than 500 lines"; echo "next: move detail into openspec/specs/ or docs/, keep AGENTS.md a map"; exit 1; }
	@grep -q TODO AGENTS.md && echo "WARN: AGENTS.md still contains TODO items" || true
	@if [ -d openspec ]; then \
		npx -y @fission-ai/openspec@1.7.0 validate --all --strict || { echo "next: fix the specs listed above, then re-run make sdd-check"; exit 1; }; \
	else \
		echo "FAIL: openspec/ directory is missing"; echo "next: run sdd-kit/install.sh --repo-only on this repo"; exit 1; \
	fi
	@# spec-lint is ADVISORY here: it exits 0 unless SPEC_LINT_STRICT=1, so its
	@# output is a report, not a gate. Its findings are printed, never swallowed.
	@# TODO: set SPEC_LINT_STRICT=1 in CI (sdd-ci.yml) once the specs stabilize —
	@# then this becomes a real gate and the summary line below must say so.
	@if [ -f .claude/scripts/spec-lint.py ]; then python3 .claude/scripts/spec-lint.py; fi
	@$(MAKE) --no-print-directory sdd-flags
	@echo "sdd-check: OK — gates passed (AGENTS.md, openspec validate, sdd-flags); spec-lint is advisory"

# Advisory single-entry test gate (ADR-0015): ruff + pytest, run on demand
# (make sdd-test) and as an advisory CI job — NOT part of sdd-check, so
# pre-commit / sdd-check stay fast. Named sdd-test (not test) so it never
# collides with a repo's own test target. Each half no-ops with a clear echo
# when the repo has nothing of that kind to run; a real run that fails exits
# non-zero (this target is meant to go red when it should).
sdd-test:
	@FAILED=0; \
	if [ -f ruff.toml ] || [ -f .ruff.toml ] || { [ -f pyproject.toml ] && grep -q '^\[tool\.ruff\]' pyproject.toml; }; then \
		echo "make sdd-test: ruff config found — running ruff check ."; \
		if command -v ruff >/dev/null 2>&1; then RUFF="ruff"; \
		elif command -v uvx >/dev/null 2>&1; then RUFF="uvx ruff"; \
		else echo "FAIL: ruff config found but neither ruff nor uvx is installed"; FAILED=1; RUFF=""; fi; \
		[ -n "$$RUFF" ] && { $$RUFF check . || FAILED=1; }; \
	else \
		echo "make sdd-test: no ruff config (ruff.toml/.ruff.toml/[tool.ruff]) — lint skipped"; \
	fi; \
	if [ -d tests ] || [ -f pytest.ini ] || { [ -f pyproject.toml ] && grep -q '^\[tool\.pytest' pyproject.toml; }; then \
		echo "make sdd-test: tests found — running pytest -q"; \
		if command -v pytest >/dev/null 2>&1; then PYTEST="pytest"; \
		elif command -v uv >/dev/null 2>&1; then PYTEST="uv run pytest"; \
		elif command -v uvx >/dev/null 2>&1; then PYTEST="uvx pytest"; \
		else echo "FAIL: tests found but neither pytest, uv, nor uvx is installed"; FAILED=1; PYTEST=""; fi; \
		[ -n "$$PYTEST" ] && { $$PYTEST -q || FAILED=1; }; \
	else \
		echo "make sdd-test: no tests found — skipped"; \
	fi; \
	exit "$$FAILED"

# Codebase knowledge graph (graphify), builds/updates graphify-out/graph.json
# over source code + openspec/ + docs/. Manual invocation only — run it
# yourself before a big intake (ticket/spec verification); NOT part of
# sdd-check/pre-commit/CI, and it never spawns background processes.
# ADR-0004: graphify is navigation/context ONLY, never a CI gate — its edges
# are INFERRED (best-effort relationships), not verified facts; treat graph
# answers as leads to check against the actual code, not ground truth.
sdd-index:
	@command -v graphify >/dev/null 2>&1 || { echo "graphify not installed — run sdd-kit/install.sh --machine-only"; exit 0; }
	@if [ -f graphify-out/graph.json ]; then \
		echo "sdd-index: existing graph found — incremental update (AST-only, no LLM key needed)"; \
		graphify update . || echo "sdd-index: update failed (see output above) — advisory, not a gate"; \
	elif [ -n "$$GEMINI_API_KEY$$GOOGLE_API_KEY$$ANTHROPIC_API_KEY$$OPENAI_API_KEY$$MOONSHOT_API_KEY$$DEEPSEEK_API_KEY" ]; then \
		echo "sdd-index: no graph yet — building index over code + openspec/ + docs/"; \
		graphify extract . --out . || echo "sdd-index: build failed (see output above) — advisory, not a gate"; \
	else \
		echo "sdd-index: no graph yet and no LLM API key in env (docs need semantic extraction)."; \
		echo "  On a Claude subscription: run the interactive '/graphify' command in Claude Code"; \
		echo "  (uses your session, no API key). After the first build, 'make sdd-index'"; \
		echo "  keeps the graph updated with no key (AST-only). Advisory, not a gate."; \
	fi
