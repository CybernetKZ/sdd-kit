# SDD checks (included from the main Makefile via: -include Makefile.sdd)
# Installed by sdd-kit/bootstrap.sh.

.PHONY: sdd-check sdd-audit

sdd-audit:
	@sh .claude/scripts/repo-audit.sh

sdd-check:
	@test -f AGENTS.md || { echo "FAIL: AGENTS.md is missing"; exit 1; }
	@[ "$$(wc -l < AGENTS.md)" -le 500 ] || { echo "FAIL: AGENTS.md is longer than 500 lines"; exit 1; }
	@grep -q TODO AGENTS.md && echo "WARN: AGENTS.md still contains TODO items" || true
	@if [ -d openspec ]; then \
		npx -y @fission-ai/openspec@1.6.0 validate --all --strict || exit 1; \
	else \
		echo "FAIL: openspec/ directory is missing (run sdd-kit/bootstrap.sh)"; exit 1; \
	fi
	@if [ -f .claude/scripts/spec-lint.py ]; then python3 .claude/scripts/spec-lint.py >/dev/null || exit 1; fi
	@echo "sdd-check: OK"
