# SDD checks (included from the main Makefile via: -include Makefile.sdd)
# Installed by sdd-kit/bootstrap.sh.

.PHONY: sdd-check sdd-audit sdd-doctor sdd-review sdd-flags

# Feature-flag expiry gate (ADR-0007): every registered flag has a death date.
# No feature_flags.py in the repo -> nothing to check, passes.
sdd-flags:
	@FILES=$$(git ls-files '*feature_flags.py' 2>/dev/null); \
	if [ -z "$$FILES" ]; then echo "sdd-flags: no flag registry — OK"; else \
	for f in $$FILES; do python3 "$$f" --check || exit 1; done; fi

# AI review of your current branch vs dev, on YOUR machine with YOUR
# subscription login (no shared tokens; CI AI-step stays optional).
SDD_REVIEW_BASE ?= dev
sdd-review:
	@command -v claude >/dev/null || { echo "FAIL: claude CLI not found"; echo "next: install Claude Code and log in"; exit 1; }
	@git diff "$(SDD_REVIEW_BASE)"...HEAD > /tmp/sdd-review.diff
	@test -s /tmp/sdd-review.diff || { echo "sdd-review: 0 changes vs $(SDD_REVIEW_BASE) — nothing to review"; exit 0; }
	@claude -p "Read /tmp/sdd-review.diff (diff of this branch vs $(SDD_REVIEW_BASE)). \
	Review it following the rules in .claude/agents/python-reviewer.md, \
	.claude/agents/fastapi-reviewer.md and .claude/agents/database-reviewer.md \
	(read them first; apply each where relevant). Repo context: AGENTS.md. \
	Report ONLY CRITICAL and HIGH issues, each with file:line and a one-line fix. \
	If there are none, reply exactly: LGTM — no CRITICAL/HIGH issues." \
	--allowedTools "Read,Grep,Glob"

sdd-audit:
	@sh .claude/scripts/repo-audit.sh

sdd-doctor:
	@bash .claude/scripts/sdd-doctor.sh

sdd-check:
	@test -f AGENTS.md || { echo "FAIL: AGENTS.md is missing"; echo "next: run sdd-kit/bootstrap.sh on this repo"; exit 1; }
	@[ "$$(wc -l < AGENTS.md)" -le 500 ] || { echo "FAIL: AGENTS.md is longer than 500 lines"; echo "next: move detail into openspec/specs/ or docs/, keep AGENTS.md a map"; exit 1; }
	@grep -q TODO AGENTS.md && echo "WARN: AGENTS.md still contains TODO items" || true
	@if [ -d openspec ]; then \
		npx -y @fission-ai/openspec@1.6.0 validate --all --strict || { echo "next: fix the specs listed above, then re-run make sdd-check"; exit 1; }; \
	else \
		echo "FAIL: openspec/ directory is missing"; echo "next: run sdd-kit/bootstrap.sh on this repo"; exit 1; \
	fi
	@if [ -f .claude/scripts/spec-lint.py ]; then python3 .claude/scripts/spec-lint.py >/dev/null || { echo "next: run python3 .claude/scripts/spec-lint.py for the full JSON report"; exit 1; }; fi
	@$(MAKE) --no-print-directory sdd-flags
	@echo "sdd-check: OK — all gates passed (AGENTS.md, openspec validate, spec-lint, sdd-flags)"
