{
  "extraKnownMarketplaces": {
    "cybernet": {
      "source": { "source": "github", "repo": "CybernetKZ/code-conventions" }
    }
  },
  "enabledPlugins": {
    "code-conventions@cybernet": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-no-verify.cjs\"" }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/spec-guard.cjs\"" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-compact.cjs\"" }
        ]
      }
    ]
  }
}
