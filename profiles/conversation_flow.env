# conversation_flow: flat Python 3.11 modules; LIVING SPEC in docs/DOCUMENTATION.md;
# make test = lint-brand + lint-migrations + ruff + pytest (keep as-is).
# editor/ (frontend), flows/ (data), migrations/ (append-only) stay free.
# spec-guard is controlled solely by .spec-guard-paths: the prefixes below make
# edits under them require an active openspec/changes/*. If this repo should NOT
# be openspec-gated, drop PROFILE_SPEC_GUARD_PATHS (or empty .spec-guard-paths)
# and the hook self-disables — PROFILE_LIVING_SPEC only adds the pre-commit warn.
# The real prefixes are kept below, commented out INSIDE the value: the file is
# still created, so the opt-out is documented in the repo instead of looking like
# "nobody got round to it" (a bare missing file makes sdd-doctor say "no
# .spec-guard-paths", which reads as an oversight). Comments-only = zero prefixes
# = spec-guard and living-spec-check stay silent. Phase 5 of the CF migration
# turns the gate on by uncommenting the nine prefixes here and re-installing.
PROFILE_SPEC_GUARD_PATHS='# spec-guard is OFF on purpose until phase 5 of the CF migration
# (sdd-kit/docs/PLAN_CF_MIGRATION.md). Uncomment the prefixes below to require an
# active openspec/changes/* for edits under them. While no prefix is active,
# spec-guard.cjs and the living-spec pre-commit fragment are deliberate no-ops.
#api/
#analytics/
#copilot/
#engine/
#livekit_agent/
#rag/
#recording/
#storage/
#webhooks/'
PROFILE_LIVING_SPEC=1
# openspec/ (converted from docs/ + .claude/) lives only on test-sdd-kit,
# not on main. If openspec/ is missing/empty at install time, restore it from there
# instead of scaffolding an empty skeleton.
PROFILE_OPENSPEC_SEED_REF=test-sdd-kit
