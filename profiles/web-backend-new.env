# WBN: monorepo of 8 Python services. Guard service source dirs only —
# tests/, values/, migrations/, docs/, scripts/ stay free to edit.
PROFILE_STORE=1
PROFILE_SPEC_GUARD_PATHS='backend/app/
backend/api/
backend/core/
backend/database/
backend/background_task_workers/
backend/messaging/
backend/middleware/
backend/websockets_service/
api-gateway-service/app/
call-dispatcher-llm/core/
call-dispatcher-llm/repo/
call-dispatcher-llm/schema/
call-dispatcher-llm/service/
call-dispatcher-llm/util/
asterisk-json-creator-llm/core/
asterisk-json-creator-llm/schema/
asterisk-json-creator-llm/service/
post-call-processor-llm/core/
post-call-processor-llm/model/
post-call-processor-llm/repo/
post-call-processor-llm/schema/
post-call-processor-llm/service/
post-call-processor-llm/background_workers/
post-chat-processor/app/
post-chat-processor/api/
post-chat-processor/core/
post-chat-processor/database/
sso-service/app/
sso-service/api/
sso-service/core/
sso-service/database/
sso-service/utils/
validation-service/core/
validation-service/model/
validation-service/service/'

# Per-service .env a fresh clone must have to run docker compose (sdd-doctor checks presence).
PROFILE_ENV_FILES='api-gateway-service/.env
asterisk-json-creator-llm/.env
backend/.env
call-dispatcher-llm/.env
post-call-processor-llm/.env
post-chat-processor/.env
sso-service/.env
validation-service/.env'
